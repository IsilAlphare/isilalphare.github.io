---
interface Props { href: string; title: string; }
const { href, title } = Astro.props;
---
<a class="collection-link" href={href} aria-label={`拾览${title}`}>
  <span>拾览</span>
  <svg viewBox="0 0 48 32" fill="none" aria-hidden="true"><ellipse cx="25" cy="16" rx="19" ry="7" transform="rotate(-25 25 16)"/><path d="m25 5 3 8 8 3-8 3-3 8-3-8-8-3 8-3Z"/><circle cx="7" cy="23" r="1.5"/></svg>
</a>
<style>
  .collection-link { display: inline-flex; align-items: center; align-self: flex-start; gap: 14px; min-height: 44px; color: #cbb99e; font-size: 12px; letter-spacing: .16em; }
  svg { width: 44px; height: 30px; stroke: currentColor; stroke-width: .8; transition: transform .4s ease, color .4s ease; }
  ellipse { opacity: .45; }
  circle { fill: currentColor; stroke: none; }
  .collection-link:hover { color: #dfcde8; }
  .collection-link:hover svg { transform: translateX(3px) rotate(8deg); }
  .collection-link:focus-visible { outline: 1px solid var(--nebula-haze); outline-offset: 4px; border-radius: 4px; }
  @media (prefers-reduced-motion: reduce) { svg { transition: none; } .collection-link:hover svg { transform: none; } }
</style>
