---
import StarlightCount from './StarlightCount.astro';
import { walineServerURL } from '../lib/comments';
import '@waline/client/style';
import '../styles/waline.css';
interface Props { kind?: 'guestbook'|'article'|'travel' }
const { kind='guestbook' }=Astro.props;
const publicBook=kind==='guestbook';
const Heading=publicBook?'h1':'h2';
---
<section class="live-letter-board" id="comments" data-path={publicBook?'/guestbook/':Astro.url.pathname} aria-labelledby="comments-title">
  <header class="live-board-heading">
    <span class="live-board-star" aria-hidden="true">✧</span>
    <div><p class="live-board-script">{publicBook?'Letters among the stars':'A little echo'}</p>
      <div class="live-title-row"><Heading id="comments-title">{publicBook?'星间来信':kind==='travel'?'旅途回声':'星下回声'}</Heading>
      {publicBook && <span class="live-count"><StarlightCount /></span>}</div>
      <p>{publicBook?'一颗流星曾路过这里':kind==='travel'?'在这段旅途的末尾，留下你的声音。':'读到这里，也留下你的声音。'}</p>
    </div>
  </header>
  <p class="live-notice">寄出的文字会公开展示。可以不登录直接留言；登录后可管理自己的来信。</p>
  <div class="live-marks" role="group" aria-label="带来一枚小印记">
    <span>随信带来</span>
    {[['✧','星光'],['☾','月牙'],['❧','叶子'],['≈','海风']].map(([mark,label])=><button type="button" data-mark={mark} aria-label={'带来'+label}><b aria-hidden="true">{mark}</b>{label}</button>)}
  </div>
  <div class="waline-thread"><div class="letter-skeleton" role="status" aria-label="正在展开信笺">
    <span class="skeleton-name" aria-hidden="true"></span><span class="skeleton-line" aria-hidden="true"></span><span class="skeleton-line short" aria-hidden="true"></span><span class="skeleton-send" aria-hidden="true"></span>
    <p>正在展开信笺……</p>
  </div></div>
  <noscript>请启用 JavaScript 查看与发送留言。</noscript>
  <a class="live-manage" href={walineServerURL+'/ui'} target="_blank" rel="noopener noreferrer">管理来信</a>
</section>
<script>
  import { onPageLoad } from '../lib/pageLifecycle';
  import { walineServerURL } from '../lib/comments';
  import { commentPath } from '../lib/commentIdentity.mjs';
  onPageLoad(({signal, cleanup}) => {

  const board=document.querySelector<HTMLElement>('.live-letter-board');
  if(board){
    const mount=board.querySelector<HTMLElement>('.waline-thread')!;
    const ready=import('@waline/client').then(({init})=>{
      if(signal.aborted)return;
      const instance=init({
        el:mount,serverURL:walineServerURL,path:commentPath(board.dataset.path!),
        lang:'zh-CN',dark:true,meta:['nick'],requiredMeta:[],login:'enable',
        wordLimit:520,pageSize:10,emoji:false,search:false,imageUploader:false,
        texRenderer:false,highlighter:false,reaction:false,pageview:false,
        locale:{nick:'昵称',anonymous:'路过的朋友',placeholder:'留下此刻想到的事……',
          submit:'寄出这封信',comment:'过往的信件',sofa:'第一封来信，正等着你。',
          admin:'穹庐主人',reply:'回复',login:'登录',logout:'退出登录',commentUnderReview:'来信已收到，等待展示。'}
      });
      cleanup(()=>instance?.destroy());
      return instance;
    }).catch(()=>{mount.textContent='信笺暂时未能展开，请刷新页面重试。';});
    function editor(){return mount.querySelector<HTMLTextAreaElement>('textarea');}
    let focusIdentity=false;
    function closeIdentityMenus(){
      mount.querySelectorAll<HTMLElement>('.wl-login-info').forEach(info=>{
        info.classList.remove('identity-open');
        info.querySelector('.wl-login-nick')?.setAttribute('aria-expanded','false');
      });
    }
    mount.addEventListener('click',(event)=>{
      const target=event.target as HTMLElement;
      const info=target.closest<HTMLElement>('.wl-login-info');
      const nick=target.closest('.wl-login-info > .wl-login-nick');
      if(nick && info){
        event.preventDefault();event.stopImmediatePropagation();
        const open=info.classList.toggle('identity-open');
        nick.setAttribute('aria-expanded',String(open));
      }
    },{capture:true,signal});
    document.addEventListener('click',(event)=>{
      if(!(event.target as HTMLElement).closest('.wl-login-info'))closeIdentityMenus();
    },{signal});
    mount.addEventListener('keydown',(event)=>{
      if(event.key==='Escape'){closeIdentityMenus();mount.querySelector<HTMLElement>('.wl-login-info > .wl-login-nick')?.focus();}
      if(event.key===' ' && (event.target as HTMLElement).matches('.wl-login-info > .wl-login-nick')){
        event.preventDefault();(event.target as HTMLElement).click();
      }
    },{signal});
    const observer=new MutationObserver(()=>{
      mount.querySelectorAll<HTMLElement>('.wl-login-info').forEach(info=>{
        const nick=info.querySelector<HTMLElement>(':scope > .wl-login-nick');
        if(nick && !nick.hasAttribute('aria-expanded')){
          nick.setAttribute('role','button');nick.setAttribute('aria-expanded','false');
          nick.setAttribute('aria-label',`切换或退出：${nick.textContent}`);nick.title='管理留言身份';
        }
        const sourceAvatar=info.querySelector<HTMLImageElement>('.wl-avatar img');
        if(nick && sourceAvatar && !nick.querySelector('.identity-avatar')){
          const avatar=sourceAvatar.cloneNode(true) as HTMLImageElement;
          avatar.className='identity-avatar';avatar.alt='';
          nick.prepend(avatar);
        }
        const menu=info.querySelector<HTMLElement>('.wl-avatar');
        const logout=menu?.querySelector<HTMLButtonElement>('.wl-logout-btn');
        if(menu && logout && !menu.querySelector('.identity-switch')){
          const change=document.createElement('button');change.type='button';change.className='identity-switch';change.textContent='切换身份';
          change.addEventListener('click',()=>{focusIdentity=true;logout.click();},{signal});
          menu.prepend(change);
        }
      });
      const nickname=mount.querySelector<HTMLInputElement>('#wl-nick');
      if(nickname){
        nickname.placeholder='怎么称呼你？（填写昵称）';
        nickname.setAttribute('aria-label','昵称（选填）');
        nickname.autocomplete='nickname';
        if(focusIdentity){focusIdentity=false;nickname.focus({preventScroll:true});}
      }
      const input=editor();
      if(input){input.id='comment-message';input.setAttribute('aria-label','想留下的话');}
    });
    observer.observe(mount,{childList:true,subtree:true});
    cleanup(()=>observer.disconnect());
    board.querySelectorAll<HTMLButtonElement>('[data-mark]').forEach(button=>{
      button.addEventListener('click',()=>{
        const input=editor();if(!input)return;
        input.value=button.dataset.mark+'\n\n'+input.value.replace(/^[✧☾❧≈]\s*/u,'');
        input.dispatchEvent(new Event('input',{bubbles:true}));
        input.focus({preventScroll:true});
        if(!matchMedia('(prefers-reduced-motion: reduce)').matches)
          button.animate([{transform:'translateY(0)'},{transform:'translateY(-4px) rotate(-8deg)'},{transform:'translateY(0)'}],{duration:500});
      });
    });
    window.addEventListener('starlight-letter-saved',async()=>{
      const instance=await ready;if(signal.aborted)return;instance?.update({path:commentPath(board.dataset.path!)});
    },{signal});
    window.addEventListener('focus-comment',async()=>{
      await ready;if(signal.aborted)return;
      requestAnimationFrame(()=>{if(!signal.aborted)editor()?.focus({preventScroll:true});});
    },{signal});
  }
  });
</script>

<style>
.letter-skeleton{position:relative;min-height:270px;padding:24px;border:1px solid #bca5cc24;border-radius:8px 32px 8px 8px;background:#13111c55;overflow:hidden;}
.letter-skeleton>span{display:block;border-radius:5px;background:linear-gradient(100deg,#bca5cc09,#bca5cc18,#bca5cc09);background-size:200% 100%;animation:letter-shimmer 2.4s ease-in-out infinite;}
.skeleton-name{width:30%;height:18px;margin-bottom:32px;}.skeleton-line{width:85%;height:12px;margin-bottom:16px;}.skeleton-line.short{width:58%;}.skeleton-send{width:90px;height:32px;margin:40px 0 0 auto;}
.letter-skeleton p{margin:14px 0 0;color:#a59aaf;font-size:12px;letter-spacing:.08em;}
@keyframes letter-shimmer{to{background-position:-200% 0;}}
@media(prefers-reduced-motion:reduce){.letter-skeleton>span{animation:none;}}
</style>
