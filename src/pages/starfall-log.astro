---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemoryLandscape from '../components/MemoryLandscape.astro';
import StarfallEmblem from '../components/StarfallEmblem.astro';
import FlowingLabel from '../components/FlowingLabel.astro';
import '../styles/starfall.css';
import { starfallNodes } from '../data/starfallLog';

const formatWhisper = (text = '') => text
  .split('\n')
  .map((line) => {
    const trimmed = line.trim();
    if (trimmed.startsWith('*') && trimmed.endsWith('*')) {
      return `<em>${trimmed.slice(1, -1)}</em>`;
    }
    return line;
  })
  .join('<br/>');

const getTemperatureClass = (node: { theme: string }) => {
  if (node.theme === 'dark') return 'node-temp-dark';
  if (node.theme === 'steel') return 'node-temp-steel';
  if (node.theme === 'winter') return 'node-temp-winter';
  if (node.theme === 'summer') return 'node-temp-summer';
  return '';
};
---

<BaseLayout title="逐星記 Starfall Log · Starry Dome" description="一页关于星空、远行、蛰伏与重返的逐星时间轴。">
  <section class="starfall-hero">
    <div class="starfall-hero-image" aria-hidden="true"></div>
    <div class="starfall-hero-content">
      <div class="starfall-totem"><StarfallEmblem /></div>
      <h1><span class="title-zh">逐星記</span><FlowingLabel text="Starfall Log" /></h1>
      <p class="starfall-subtitle">我在群星之下学会谦卑,又在人类垒起的高峰前重新长出骨骼。</p>
    </div>
  </section>

  <section class="starfall-timeline" aria-label="逐星记忆航道">
    <div class="memory-boat" aria-hidden="true"><svg viewBox="0 0 32 76" fill="none"><path class="boat-wake" d="M6 3Q16 9 26 3M9 10Q16 14 23 10"/><path d="M7 24Q16 19 25 24L26 49Q24 63 16 71Q8 63 6 49Z" fill="#13111c"/><path d="M11 24V56L16 65L21 56V24M7 39H25"/><rect x="11" y="28" width="10" height="8" rx="1"/><path d="M13 43H19V53H13Z" fill="currentColor" fill-opacity=".25"/><circle cx="16" cy="60" r="1.5" fill="currentColor"/></svg></div>
    {starfallNodes.map((node, index) => {
      return (
        <article class={`timeline-node theme-${node.theme} ${getTemperatureClass(node)} ${index % 2 === 1 ? 'is-alt' : ''}`} data-reveal>
          <div class="timeline-dot" aria-hidden="true"></div>
          <div class="timeline-card">
            <div class="timeline-media">
              <MemoryLandscape scene={node.illustration} />
            </div>

            <div class="timeline-copy">
              <p class="memory-date"><span aria-hidden="true">✧</span> {node.year.split(" ")[0]}</p>
              <h2>
                {node.articleUrl ? <a class="timeline-title-link" href={node.articleUrl}>{node.title}</a> : node.title}
              </h2>
              {node.subtitle && <p class="timeline-subtitle" set:html={node.subtitle}></p>}
              {node.whisper && <blockquote class="timeline-whisper" set:html={formatWhisper(node.whisper)}></blockquote>}
              {node.footnote && <p class="timeline-footnote">{node.footnote}</p>}
            </div>
          </div>

        </article>
      );
    })}
  </section>

  <section class="starfall-ending">
    <p>我终究没能成为天文学家,只做了一个爱好者;可正因如此,星空于我永远是热爱,而非生计。</p>
    <div class="ending-star" aria-hidden="true">✧</div>
    <h2>寻我于万千繁星之中</h2>
    <div class="ending-quenya">Elen síla lúmenn’ omentielvo.</div>
    <div class="hero-actions">
      <a class="btn primary" href="/">返回主站</a>
      <a class="btn" href="/about/">回到关于页</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { readingPosition } from '../lib/starfallProgress.mjs';
  const river = document.querySelector<HTMLElement>('.starfall-timeline')!;
  const boat = river.querySelector<HTMLElement>('.memory-boat')!;
  const nodes = Array.from(river.querySelectorAll<HTMLElement>('.timeline-node'));
  let stops: number[] = [];
  let colors: string[] = [];
  let frame = 0;
  const update = () => {
    frame = 0;
    const marker = window.innerHeight * .52 - river.getBoundingClientRect().top;
    const { y, index } = readingPosition(marker, stops);
    boat.style.transform = `translate(-50%, -50%) translateY(${y}px)`;
    boat.style.color = colors[index];
    nodes.forEach((node, i) => {
      node.classList.toggle('is-current', i === index);
      node.classList.toggle('is-past', stops[i] <= y);
    });
  };
  const measure = () => {
    const top = river.getBoundingClientRect().top;
    stops = nodes.map(node => {
      const rect = node.querySelector('.timeline-dot')!.getBoundingClientRect();
      return rect.top + rect.height / 2 - top;
    });
    colors = nodes.map(node => getComputedStyle(node).getPropertyValue('--node-accent').trim());
    river.style.setProperty('--river-start', `${stops[0]}px`);
    river.style.setProperty('--river-end', `${river.offsetHeight - stops[stops.length - 1]}px`);
    update();
  };
  const requestUpdate = () => { if (!frame) frame = requestAnimationFrame(update); };
  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', measure);
  new ResizeObserver(measure).observe(river);
  document.fonts.ready.then(measure);
  measure();
</script>
