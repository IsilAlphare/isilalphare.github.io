---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const reviews = (await getCollection('posts', ({ data }) => Boolean(data.screen)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---
<BaseLayout title="银幕潮汐 · Starry Dome" description="电影、剧集与音乐剧，散场之后仍在心里回响的故事。">
  <section class="page-hero">
    <a class="article-back" href="/collections/">← 回到收藏馆</a>
    <p class="eyebrow">Screen tides · {reviews.length} 篇影评</p>
    <h1>银幕潮汐</h1>
    <p>电影、剧集与音乐剧，散场之后仍在心里回响的故事。</p>
  </section>
  <section class="content-section screen-list" aria-label="影评列表">
    {reviews.map((post) => (
      <article class="panel screen-entry">
        <p class="eyebrow">{post.data.screen!.type} · {post.data.screen!.work}</p>
        <h2><a href={`/posts/${post.data.slug}/`}>{post.data.title}</a></h2>
        <blockquote>{post.data.screen!.excerpt}</blockquote>
        <footer>
          <span>写于 <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time></span>
          <a class="article-back" href={`/posts/${post.data.slug}/`} aria-label={`阅读《${post.data.title}》全文`}>阅读影评 →</a>
        </footer>
      </article>
    ))}
  </section>
</BaseLayout>
<style>
  .screen-list { display: grid; gap: 24px; max-width: 960px; margin-inline: auto; }
  .screen-entry { padding: clamp(24px, 5vw, 48px); min-width: 0; }
  .screen-entry h2 { font-family: "IBM Plex Serif", Georgia, serif; font-size: clamp(24px, 3vw, 34px); font-weight: 400; line-height: 1.55; margin: 14px 0 22px; overflow-wrap: anywhere; }
  .screen-entry h2 a { color: var(--starlight); }
  .screen-entry h2 a:hover { color: var(--elf-starlight); }
  .screen-entry blockquote { margin: 0 0 30px; padding-left: 20px; border-left: 2px solid var(--elf-violet); color: var(--asteroid); line-height: 1.9; }
  .screen-entry footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; font-size: 13px; color: var(--asteroid); }
</style>
