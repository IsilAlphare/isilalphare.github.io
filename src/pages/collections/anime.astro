---
import { Image } from 'astro:assets';
import CelestialMotif from '../../components/CelestialMotif.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { animeWorks } from '../../data/anime';
const motifs = ['rose', 'arch', 'halo', 'eclipse', 'orbit', 'cross'];
---
<BaseLayout title="次元回响 · Starry Dome" description="那些塑造了我对美、死亡、宗教、暴力与政治最初认识的动画作品。">
  <section class="page-hero anime-hero">
    <a class="article-back" href="/collections/">← 回到收藏馆</a>
    <p class="eyebrow">动画收藏</p>
    <h1>次元回响</h1>
    <p class="opening">这些作品塑造了我对美、死亡、宗教、暴力与政治的最初认识，带来过正向与负向的启蒙。</p>
    <div class="threshold" aria-hidden="true"><span></span>✧<span></span></div>
  </section>
  <section class="content-section anime-collection" aria-label="留下启蒙的动画作品">
    <ul class="work-grid">
      {animeWorks.map(({title, cover}, index) => (
        <li class:list={['work', `tone-${index % 4}`, { 'film-work': index >= 12 }]}>
          <div class="work-cover"><Image src={cover} alt={`${title}动画海报`} widths={[240, 400, 640]} sizes="(max-width: 700px) 45vw, 30vw" width={640} format="webp" loading={index < 3 ? "eager" : "lazy"} /></div>
          <div class="motif" aria-hidden="true"><CelestialMotif variant={motifs[index % motifs.length]} /></div>
          <div class="work-caption"><span class="small-star" aria-hidden="true">✦</span><h2>{title}</h2></div>
        </li>
      ))}
    </ul>
    <div class="closing"><span aria-hidden="true">✧</span><a href="/about/">关于我与这些世界 →</a></div>
  </section>
</BaseLayout>
<style>
  .anime-hero { text-align: center; padding-bottom: 0; }
  .anime-hero .article-back { display: block; text-align: left; margin-bottom: 54px; }
  .anime-hero .eyebrow { font-size: 12px; letter-spacing: .3em; margin: 0 auto 20px; color: var(--nebula-haze); }
  .anime-hero h1 { margin: 0 0 30px; font-weight: 400; letter-spacing: .08em; }
  .anime-hero .opening { max-width: 620px; margin: auto; font-size: 17px; line-height: 2.15; text-wrap: pretty; }
  .threshold { display: flex; align-items: center; justify-content: center; gap: 24px; margin: 42px auto 12px; color: #c8b49a; font-size: 26px; }
  .threshold span { width: 100px; height: 1px; background: linear-gradient(90deg, transparent, #b3a4c54d); }
  .threshold span:last-child { transform: rotate(180deg); }
  .work-grid { list-style: none; display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 20px; padding: 0; margin: 0; }
  .work { --ink: #c7a5be; position: relative; isolation: isolate; overflow: hidden; grid-column: span 2;  border: 1px solid color-mix(in srgb,var(--ink) 20%,transparent); border-radius: 16px 16px 8px 8px; background: radial-gradient(ellipse at 50% 12%,color-mix(in srgb,var(--ink) 9%,transparent),transparent 72%), #14131c; }
  .tone-1 { --ink: #aaa6cc; }
  .tone-2 { --ink: #b4c4bd; }
  .tone-3 { --ink: #c6b594; }
  .work-cover { aspect-ratio: 2 / 3; overflow: hidden; background: #0d0c14; }
  .work-cover :global(img) { display:block; width:100%; height:100%; object-fit:contain; transition:transform .6s ease; }
  .work:hover .work-cover :global(img) { transform:scale(1.025); }
  .work-caption { position: relative; padding: 18px 14px 24px; min-height: 92px; text-align: center; background: linear-gradient(180deg,#191522,#11101a); }
  .work h2 { margin: 12px 0 0; color: var(--elf-starlight); font-family: 'IBM Plex Serif', Georgia, serif; font-size: clamp(17px,1.8vw,23px); font-weight: 400; letter-spacing: .04em; overflow-wrap: anywhere; }
  .small-star { color: var(--ink); font-size: 9px; }
  .motif { position: absolute; width: 62px; height: 62px; bottom: 10px; right: -8px; z-index: 2; pointer-events:none; color: var(--ink); opacity: .16; }
  .closing { display: grid; justify-items: center; gap: 24px; margin-top: 58px; color: var(--nebula-haze); }
  .closing a { font-size: 13px; color: var(--comet); }
  a:focus-visible { outline: 1px solid var(--nebula-haze); outline-offset: 5px; }
  @media (max-width: 700px) {
    .work-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
    .work { grid-column: span 1; }
    .work { border-radius: 12px 12px 6px 6px; }
    .work h2 { font-size: 16px; line-height:1.5; }
    .work-caption { padding: 12px 8px 18px; min-height:88px; }
    .motif { width:48px; height:48px; }
    .anime-hero .opening { font-size: 15px; text-align: left; }
    .anime-hero .article-back { margin-bottom: 42px; }
    .anime-hero h1 { font-size: clamp(34px,9vw,60px); }
  }
  @media (prefers-reduced-motion: reduce) { .work-cover :global(img) { transition:none; } .work:hover .work-cover :global(img) { transform:none; } }
</style>
