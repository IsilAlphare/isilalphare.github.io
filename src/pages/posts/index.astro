---
import { getCollection } from 'astro:content';
import { sortCategoriesByLatestPost } from '../../lib/postCategoryOrder.mjs';
import FlowingLabel from '../../components/FlowingLabel.astro';
import CelestialMotif from '../../components/CelestialMotif.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postCategories } from '../../data/posts';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const categoryGroups = sortCategoriesByLatestPost(postCategories.map((category) => ({
  ...category,
  posts: posts.filter((post) => post.data.category === category.title),
})));

const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---
<BaseLayout title="星轨，天空的道路 · Starry Dome" description="每一次回望都能沿着微光抵达来处。">
  <section class="page-hero">
    <FlowingLabel text="Stellar Paths" />
    <h1>星轨，天空的道路</h1>
    <p>每一次回望都能沿着微光抵达来处。</p>
  </section>
  <section class="content-section">
    <div class="article-category-list">
      {categoryGroups.map((category) => (
        <section class="article-category panel" id={category.key} style="scroll-margin-top: 110px;">
          <header class="article-category-header">
            <div class="archive-motif"><CelestialMotif variant={category.key === "tech" ? "astrolabe" : category.key === "life" ? "leaf" : "prism"} size={90} /></div>
            <div>
              <div class="archive-label"><FlowingLabel text={category.key === "tech" ? "Craft" : category.key === "life" ? "Living" : "Echoes"} /><span>{category.posts.length} 篇</span></div>
              <h2>{category.title}</h2>
              <p>{category.subtitle}</p>
            </div>
          </header>
          <div class="archive-list">
            {category.posts.map((post) => (
              <a class="archive-row" href={`/posts/${post.data.slug}/`}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.tags.join(' · ') || category.title}</p>
                </div>
                <span class="archive-star" aria-hidden="true">✧</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
.page-hero { padding-top: 80px; }
.page-hero h1 { font-family: 'IBM Plex Serif','Songti SC',serif; font-weight:400; font-size:clamp(32px,5vw,64px); letter-spacing:.035em; margin:26px 0 20px; }
.article-category { border-radius:28px 8px; padding:32px; background:radial-gradient(ellipse at 0 0,#9b7fd410,transparent 60%),#13111c99; border-color:#baacd32c; }
.article-category-header { gap:22px; padding-bottom:30px; border-bottom:1px solid #c5b5d023; }
.archive-motif { color:#bba7d0; flex-shrink:0; }
#life .archive-motif { color:#a6b9b4; } #echo .archive-motif { color:#d0b895; }
.archive-label { display:flex; align-items:center; gap:22px; margin-bottom:12px; }
.archive-label > span { color:var(--comet); font-size:11px; letter-spacing:.12em; }
.article-category-header h2 { font-family:'IBM Plex Serif','Songti SC',serif; font-size:29px; font-weight:400; color:#e8dfc4; letter-spacing:.08em; }
.article-category-header p { margin-top:12px; line-height:1.9; }
.archive-row { padding:25px 14px; gap:24px; border-color:#c5b5d01b; border-radius:8px; transition:background .25s; }
.archive-row:hover { background:#9b7fd409; }
.archive-row h3 { font-weight:400; line-height:1.8; color:#e1d9e6; }
.archive-row p { font-size:12px; letter-spacing:.04em; margin-top:7px; }
.archive-row time { color:#a69ab1; font-size:12px; letter-spacing:.06em; }
.archive-row .archive-star { font-size:26px; color:#cbb9d2; text-shadow:0 0 16px #9b7fd445; }
.archive-row:focus-visible { outline:1px solid #baa7d0; outline-offset:3px; }
@media(max-width:600px) { .article-category { padding:22px 18px; } .article-category-header { gap:10px; } .archive-motif { margin-left:-15px; } .archive-row { padding:23px 3px; gap:10px; } .archive-row .archive-star { display:none; } .archive-label { flex-wrap:wrap; gap:8px; } }
</style>
