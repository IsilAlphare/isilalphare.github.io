---
import { getCollection, render } from 'astro:content';
import { books } from '../../data/books';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const shelfBook = books.find((book) => book.note?.postSlug === post.data.slug);
const backHref = post.data.screen ? '/collections/screen/' : shelfBook ? `/collections/books/#note-${shelfBook.id}` : '/posts/';
const backText = post.data.screen ? '← 回到银幕潮汐' : shelfBook ? '← 回到书架微光' : '← 回到文章';
const { Content } = await render(post);
const dateText = post.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} · Starry Dome`} description={`${post.data.category}：${post.data.title}`}>
  <article class="article-page migrated-post">
    <header class="article-hero">
      <a class="article-back" href={backHref}>{backText}</a>
      <p class="eyebrow">{post.data.screen ? `${post.data.screen.type} · ${post.data.screen.work} · 写于` : post.data.category} · {dateText}</p>
      <h1>{post.data.title}</h1>
      <div class="article-tags" aria-label="文章标签">
        {post.data.tags.map((tag: string) => <span>{tag}</span>)}
      </div>
    </header>

    <section class="article-body article-prose panel">
      {post.data.screen && <p class="screen-spoiler">本文包含剧情讨论，可能涉及剧透。</p>}
      <Content />
    </section>
  </article>
</BaseLayout>
