---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos } from '../data/photos';
---
<BaseLayout title="照片墙 · Starry Dome" description="精选照片与未来的年份、地点、主题分类。">
  <section class="page-hero">
    <p class="eyebrow">Photo wall</p>
    <h1>照片墙</h1>
    <p>首页只展示精选，详情页未来会按年份、地点和主题整理。第一版先使用占位图，等待真实照片替换。</p>
  </section>
  <section class="content-section">
    <div class="photo-wall">
      {photos.map((photo) => (
        <article class={`photo-card ${photo.color}`}>
          <h3>{photo.title}</h3>
          <p>{photo.meta}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
