---
import { getCollection } from 'astro:content';
import DomeObservatory from '../components/DomeObservatory.astro';
import CelestialMotif from '../components/CelestialMotif.astro';
import FlowingLabel from '../components/FlowingLabel.astro';
import CollectionLink from '../components/CollectionLink.astro';
import CollectionEmblem from '../components/CollectionEmblem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { postCategories } from '../data/posts';
import { collections } from '../data/collections';
import { trips } from '../data/travel';
import type { ImageMetadata } from 'astro';
const travelImages = import.meta.glob<{default: ImageMetadata}>('../assets/travel/*/*.{webp,jpg}', { eager: true });
const featuredTrips = [...new Set(trips.map(trip => trip.title))].slice(0, 4).map(title => trips.find(trip => trip.title === title)!);

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const categoryEmblems: Record<string, { variant: string; label: string }> = { tech: { variant: 'astrolabe', label: 'Craft' }, life: { variant: 'leaf', label: 'Living' }, echo: { variant: 'prism', label: 'Echoes' } };
const categoryCards = postCategories.map((category) => ({
  ...category,
  posts: allPosts.filter((post) => post.data.category === category.title).slice(0, 3),
  count: allPosts.filter((post) => post.data.category === category.title).length,
}));
---
<BaseLayout title={site.title} description={site.description}>
  <section class="section hero">
    <div>
      <div class="home-wordmark">
        <p class="wordmark-kicker"><span aria-hidden="true">✧</span> 星空穹庐</p>
        <h1 aria-label="Starry Dome"><span class="wordmark-script">Starry</span><span class="wordmark-serif">Dome<span class="title-star" aria-hidden="true">✧</span></span></h1>
        <div class="wordmark-rule" aria-hidden="true"><span></span>✦<span></span></div>
      </div>
      <p class="tagline home-tagline">寻我于<span>万千繁星之中</span></p>
      <p class="quenya home-quenya">{site.quenya}</p>
      <div class="hero-actions">
        <a class="btn primary" href="/posts">进入文章</a>
        <a class="btn" href="/collections">打开收藏馆</a>
      </div>
    </div>
    <DomeObservatory />
  </section>

  <section class="section home-inscription" aria-label="穹庐题记">
    <span class="inscription-star" aria-hidden="true">✧</span>
    <p>星空为穹，地为床。<br/><span>一只四维虫子的切片在此珍藏</span></p>
    <div class="inscription-rule" aria-hidden="true"></div>
  </section>

  <section class="section home-chapter">
    <div class="section-heading chapter-heading">
      <div>
        <div class="chapter-english"><FlowingLabel text="Stellar Paths" /><span aria-hidden="true">✧</span></div>
        <h2>星轨，天空的道路</h2>
      </div>
      <p>每一次回望都能沿着微光抵达来处。</p>
    </div>
    <div class="grid-3">
      {categoryCards.map((category) => (
        <article class="panel home-note-card">
          <a class="category-node" href={`/posts/#${category.key}`} aria-label={`浏览${category.title}的全部 ${category.count} 篇文章`}>
            <CelestialMotif variant={categoryEmblems[category.key].variant} size={88} />
            <FlowingLabel text={categoryEmblems[category.key].label} />
            <span class="node-arrow" aria-hidden="true">↗</span>
          </a>
          <h3><a href={`/posts/#${category.key}`}>{category.title}</a></h3>
          <p>{category.subtitle}</p>
          <div class="post-list">
            {category.posts.map((post) => (
              <a class="post-row home-post-row" href={`/posts/${post.data.slug}/`}>
                <span>{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit' })}</span>
                <strong>{post.data.title}</strong>
                <p>{post.data.tags.join(' · ') || category.title}</p>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section home-chapter">
    <div class="section-heading chapter-heading">
      <div>
        <div class="chapter-english"><FlowingLabel text="Treasured Worlds" /><span aria-hidden="true">✧</span></div>
        <h2>我的收集罐</h2>
      </div>
      <p>星光，萤火，落叶，干花，在我处一并珍藏</p>
    </div>
    <div class="collections-grid">
      {collections.map((collection) => (
        <article class="panel jar home-jar">
          <div>
            <CollectionEmblem type={collection.type} />
            <h3>{collection.href ? <a href={collection.href}>{collection.title}</a> : collection.title}</h3>
            <p>{collection.description}</p>
            <div class="tags">
              {collection.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          {collection.href ? <div class="home-jar-footer"><CollectionLink href={collection.href} title={collection.title} /></div> : <p class="meta">{collection.items.join(' · ')}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="section home-chapter">
    <div class="section-heading chapter-heading">
      <div>
        <div class="chapter-english"><FlowingLabel text="Collected Journeys" /><span aria-hidden="true">✧</span></div>
        <h2><a href="/travel/">旅途拾光</a></h2>
      </div>
      <p>漫长的夜晚，有星在回忆中闪烁</p>
    </div>
    <div class="photo-wall">
      {featuredTrips.map(trip => {
        const cover = (travelImages[`../assets/travel/${trip.assetFolder}/${trip.coverId}-thumb.${trip.extension}`] ?? travelImages[`../assets/travel/${trip.assetFolder}/${trip.coverId}.${trip.extension}`]).default;
        return <a class="photo-card" href={`/travel/${trip.slug}/`} style={`--photo-image: url('${cover.src}')`}>
          <h3>{trip.location}</h3>
          <p>{trip.date.replaceAll('-', ' · ')}</p>
        </a>;
      })}
    </div>
    <div class="travel-directory-link"><CollectionLink href="/travel/" title="旅途拾光" /></div>
  </section>
</BaseLayout>

<style>
  .travel-directory-link { display: flex; justify-content: flex-end; margin-top: 24px; }
  .home-chapter .photo-wall .photo-card { grid-column: span 6; min-height: 260px; }
  @media (max-width: 680px) { .home-chapter .photo-wall .photo-card { grid-column: span 12; min-height: 230px; } }
  .photo-card:focus-visible { outline: 2px solid var(--nebula-haze); outline-offset: 4px; }
  .category-node { display: flex; align-items: center; gap: 10px; margin: -8px 0 14px -12px; color: #bdb1d4; border-radius: 12px; }
  .category-node .node-arrow { margin-left: auto; font-size: 16px; opacity: .5; transition: opacity .2s; }
  .category-node:hover .node-arrow { opacity: 1; }
  .category-node:focus-visible { outline: 1px solid var(--nebula-haze); outline-offset: 4px; }
</style>

<style>
  .home-wordmark { position: relative; padding: 6px 0; }
  .wordmark-kicker { display: flex; align-items: center; gap: 16px; color: #bcb0c9; letter-spacing: .36em; font-size: 12px; margin: 0 0 28px; }
  .wordmark-kicker > span { font-size: 22px; color: #cfbc9b; }
  .hero .home-wordmark h1 { font-weight: 400; letter-spacing: 0; line-height: 1; padding: 0 12px; }
  .hero h1 .wordmark-script { font-family: 'Great Vibes', 'Apple Chancery', cursive; font-size: clamp(76px, 10vw, 136px); line-height: 1.25; padding-right: 24px; color: #ddc9d8; background: linear-gradient(115deg,#f0dab4 10%,#c4e3dc 32%,#cbb8e8 58%,#e7bbc8 78%,#f0dab4); background-size: 220% 100%; background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: title-shimmer 20s ease-in-out infinite alternate; }
  .hero h1 .wordmark-serif { position: relative; display: inline-block; margin: -13px 0 0 55px; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(72px, 9vw, 120px); line-height: 1.05; letter-spacing: .03em; color: #e5dccd; }
  .hero h1 .title-star { display: inline-block; position: absolute; top: 5px; right: -38px; font: 400 27px/1 Georgia,serif; color: #b5cbd2; }
  .wordmark-rule { display: flex; align-items: center; gap: 18px; max-width: 330px; margin-top: 24px; color: #baadc9; font-size: 11px; }
  .wordmark-rule > span { height: 1px; flex: 1; background: linear-gradient(90deg,transparent,#b9a6cc66); }
  .wordmark-rule > span:last-child { transform: rotate(180deg); }
  @keyframes title-shimmer { from { background-position: 0% 50%; } to { background-position: 100% 50%; } }
  @media (max-width: 680px) {
    .hero h1 .wordmark-script { font-size: clamp(76px,20vw,116px); }
    .hero h1 .wordmark-serif { font-size: clamp(72px,19vw,108px); margin-left: 38px; }
    .wordmark-kicker { margin-bottom: 16px; }
    .wordmark-rule { max-width: 270px; }
  }
  @media (prefers-reduced-motion: reduce) { .hero h1 .wordmark-script { animation: none; } }
</style>

<style>
  .hero .home-tagline { margin-top: 26px; font-family: 'IBM Plex Serif', 'Songti SC', serif; font-size: clamp(18px,2vw,25px); font-weight: 400; line-height: 1.8; letter-spacing: .1em; color: #b5abbf; }
  .home-tagline span { margin-left: .25em; color: #e1d4c0; }
  .hero .home-quenya { max-width: 410px; margin-top: 10px; font: italic 400 clamp(17px,1.8vw,21px)/1.7 'Cormorant Garamond', Georgia, serif; letter-spacing: .025em; color: #a69aaf; }
  @media (max-width: 680px) { .hero .home-tagline { font-size: 18px; letter-spacing: .06em; } }
</style>

<style>
  .home-inscription { position: relative; text-align: center; padding: 30px 20px 18px; }
  .inscription-star { display: block; font-size: 30px; color: #c3b28f; margin-bottom: 20px; }
  .home-inscription p { margin: 0; font: 400 clamp(21px,2.4vw,29px)/2 'IBM Plex Serif','Songti SC',serif; letter-spacing: .12em; color: #e0d5c3; }
  .home-inscription p span { font-size: .68em; letter-spacing: .1em; color: #aaa0b6; }
  .inscription-rule { margin: 30px auto 0; width: min(360px,80%); height: 1px; background: linear-gradient(90deg,transparent,#bda6cc55,transparent); }
  .home-chapter { padding-top: 110px; }
  .chapter-heading { position: relative; align-items: end; gap: 30px; padding-bottom: 30px; margin-bottom: 28px; border-bottom: 1px solid #b9a6ce26; }
  .chapter-heading::after { content: '✦'; position: absolute; bottom: -9px; right: 0; font-size: 10px; padding-left: 14px; color: #bdb0c9; background: #0d0c14; }
  .chapter-english { display: flex; align-items: center; gap: 24px; margin-bottom: 5px; }
  .chapter-english > span { font-size: 19px; color: #b8b9cc; opacity: .75; }
  .chapter-heading h2 { font-size: clamp(29px,3.7vw,44px); line-height: 1.5; letter-spacing: .07em; color: #e7dece; text-wrap: balance; }
  .chapter-heading > p { font-family: 'IBM Plex Serif','Songti SC',serif; font-size: 15px; line-height: 2; letter-spacing: .055em; max-width: 340px; padding-bottom: 5px; color: #afa3ba; }
  .home-note-card, .home-jar { position: relative; isolation: isolate; overflow: hidden; border-color: #b5a6cf30; background: linear-gradient(145deg,#2420308c,#13141bbf); box-shadow: inset 0 1px 0 #e1d1ed0d; }
  .home-note-card { border-radius: 32px 10px 26px 10px; padding: 28px; }
  .home-jar { border-radius: 30px 30px 12px 12px; gap: 30px; }
  .home-note-card::before, .home-jar::before { content: ''; position: absolute; z-index: -1; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 5% 0%,#b494d413,transparent 60%),radial-gradient(ellipse at 100% 100%,#87bbb90c,transparent 55%); }
  .home-note-card:nth-child(2)::before { background: radial-gradient(ellipse at 5% 0%,#8bbdb71c,transparent 60%); }
  .home-note-card:nth-child(3)::before { background: radial-gradient(ellipse at 5% 0%,#d6b79118,transparent 60%); }
  .home-note-card h3, .home-jar h3 { font-size: 25px; letter-spacing: .07em; color: #e3d7c3; margin-bottom: 14px; }
  .home-note-card > p { font-family: 'IBM Plex Serif','Songti SC',serif; font-size: 14px; letter-spacing: .035em; line-height: 1.9; min-height: 54px; }
  .home-note-card .post-list { gap: 6px; margin-top: 24px; }
  .home-note-card .post-row { padding: 16px 0 12px; border-color: #bcaac321; transition: color .2s; }
  .home-note-card .post-row:hover strong { color: #e5cfae; }
  .home-note-card .post-row strong { font-weight: 400; line-height: 1.8; }
  .home-note-card .post-row > span { font: 400 13px/1.6 'Cormorant Garamond',Georgia,serif; letter-spacing: .12em; color: #b6a3ba; }
  .home-note-card .post-row p { font-size: 11px; opacity: .75; }
  .home-jar .tags { gap: 8px; margin-top: 24px; }
  .home-jar .tags span { border-color: #bfa6ce20; background: transparent; font-size: 11px; color: #a89bae; }
  .home-jar-footer { border-top: 1px solid #b5a3c426; padding-top: 14px; }
  .home-chapter .photo-card { border-radius: 28px 8px 28px 8px; border-color: #c1abc339; }
  .home-chapter .photo-card h3 { font-family: 'IBM Plex Serif','Songti SC',serif; font-weight: 400; letter-spacing: .08em; }
  @media (max-width: 680px) {
    .home-chapter { padding-top: 76px; }
    .chapter-heading { align-items: start; gap: 16px; }
    .chapter-heading h2 { font-size: 28px; letter-spacing: .035em; }
    .chapter-heading > p { font-size: 14px; }
    .home-note-card, .home-jar { padding: 24px; }
    .home-inscription { padding-inline: 0; }
    .home-inscription p { letter-spacing: .06em; }
  }
</style>
